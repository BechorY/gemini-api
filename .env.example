# Copy to .env (gitignored) or export in your shell / cloud environment settings.
# Values: browser DevTools > Application > Cookies > https://gemini.google.com
GEMINI_SECURE_1PSID=
GEMINI_SECURE_1PSIDTS=

# Official API backend (recommended, no cookies): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (see: gemini-cli --list-models)
GEMINI_MODEL=
# Optional comma-separated fallbacks used when the default model is busy (503/429)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
